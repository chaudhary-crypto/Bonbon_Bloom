# ==============================================================================
# Bonbon Bloom — Environment & Secrets Configuration Template
# ==============================================================================
# In Google AI Studio, set these keys securely in the Secrets panel.
# Never commit real credentials to public git repositories.
#
# AdMob Production App & Unit IDs
# Debug builds use Google's official test IDs automatically.
# For production releases, provide your real registered AdMob IDs:
# ADMOB_APP_ID=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
# ADMOB_BANNER_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_INTERSTITIAL_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_REWARDED_ID=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
# ADMOB_PUBLISHER_ID=pub-XXXXXXXXXXXXXXXX

# Live Privacy Policy and Terms of Service URLs
PRIVACY_POLICY_URL=https://chaudhary-crypto.github.io/Bonbon_Bloom/privacy.html
TERMS_URL=https://chaudhary-crypto.github.io/Bonbon_Bloom/terms.html

# Google Play Keystore Credentials (for CI/CD or local release builds)
# KEYSTORE_PATH=my-upload-key.jks
# STORE_PASSWORD=your_store_password
# KEY_PASSWORD=your_key_password
