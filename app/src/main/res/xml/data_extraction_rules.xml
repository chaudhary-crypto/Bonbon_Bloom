<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="crush_candy_db"/>
        <include domain="sharedpref" path="bonbon_account_prefs.xml"/>
        <exclude domain="sharedpref" path="bonbon_ad_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="crush_candy_db"/>
        <include domain="sharedpref" path="bonbon_account_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
